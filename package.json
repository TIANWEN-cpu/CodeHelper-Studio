{
  "name": "codehelper",
  "version": "2.4.2",
  "description": "AI 驱动的桌面编程助手 — 集成代码编辑器、AI 对话、题库系统、知识库检索与错题追踪",
  "main": "./out/main/index.js",
  "scripts": {
    "native:node": "node scripts/prepare-native.cjs node",
    "native:electron": "node scripts/prepare-native.cjs electron",
    "predev": "npm run native:electron && npm run build:job-host",
    "dev": "electron-vite dev",
    "prebuild": "npm run build:job-host",
    "build": "electron-vite build",
    "prepreview": "npm run native:electron",
    "preview": "electron-vite preview",
    "build:job-host": "node scripts/build-job-host.cjs",
    "build:win": "npm run package:win && npm run verify:package:win",
    "prebuild:mac": "npm run native:electron",
    "build:mac": "electron-vite build && electron-builder --mac",
    "prebuild:linux": "npm run native:electron",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:analyze": "node -e \"process.env.ANALYZE='1';require('child_process').execSync('electron-vite build',{stdio:'inherit',env:{...process.env,ANALYZE:'1'}})\"",
    "prepackage": "npm run native:electron",
    "package": "npm run build:job-host && electron-vite build && electron-builder",
    "prepackage:win": "npm run native:electron",
    "package:win": "npm run build:job-host && electron-vite build && electron-builder --win --publish never",
    "prepackage:win:dir": "npm run native:electron",
    "package:win:dir": "npm run build:job-host && electron-vite build && electron-builder --win --dir --publish never && npm run verify:package",
    "verify:package": "node scripts/verify-package-resources.js",
    "verify:package:win": "node scripts/verify-windows-package.cjs",
    "test:job-host": "npm run build:job-host && node scripts/smoke-job-host.cjs",
    "release:patch": "node scripts/version-bump.js patch && npm run build:win",
    "release:minor": "node scripts/version-bump.js minor && npm run build:win",
    "release:major": "node scripts/version-bump.js major && npm run build:win",
    "postinstall": "npm run native:electron -- --force",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"electron/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" \"*.{md,json}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"electron/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" \"*.{md,json}\" \"docs/**/*.md\"",
    "pretest": "npm run native:node",
    "test": "vitest run",
    "pretest:e2e": "npm run native:electron",
    "test:e2e": "npm run build && playwright test --config=playwright.electron.config.ts",
    "pretest:electron-drafts": "npm run native:electron",
    "test:electron-drafts": "node scripts/run-electron-draft-test.cjs",
    "pretest:electron-workspace": "npm run native:electron",
    "test:electron-workspace": "node scripts/run-editor-workspace-electron-test.cjs",
    "pretest:electron-database-recovery": "npm run native:electron",
    "test:electron-database-recovery": "node scripts/run-database-recovery-electron-test.cjs",
    "pretest:electron-sql": "npm run native:electron",
    "test:electron-sql": "electron-vite build && electron tests/electronSqlUtilitySmoke.cjs",
    "pretest:electron-runner": "npm run native:electron",
    "test:electron-runner": "npm run build && electron tests/electronCodeRunnerUtilitySmoke.cjs",
    "pretest:docker-isolation": "npm run native:node",
    "test:docker-isolation": "vitest run tests/dockerIsolation.integration.test.ts tests/dockerRunner.test.ts",
    "pretest:knowledge-retrieval": "npm run native:node",
    "test:knowledge-retrieval": "vitest run tests/knowledgeRetrieval.test.ts tests/knowledgeRetrievalRepository.test.ts tests/knowledgeRetrievalEvaluation.test.ts tests/ragIpc.test.ts",
    "pretest:agent-tools": "npm run native:node",
    "test:agent-tools": "vitest run tests/agentWorkflow.test.ts tests/agentRepository.test.ts tests/agentTools.test.ts tests/ipcContractMatrix.test.ts",
    "pretest:watch": "npm run native:node",
    "test:watch": "vitest",
    "pretest:ui": "npm run native:node",
    "test:ui": "vitest --ui",
    "pretest:coverage": "npm run native:node",
    "test:coverage": "vitest run --coverage",
    "prebench": "npm run native:node",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "prepare": "husky"
  },
  "keywords": [
    "electron",
    "react",
    "code-editor",
    "ai-assistant",
    "programming-practice",
    "leetcode"
  ],
  "author": "SuLi <3508137206@qq.com>",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TIANWEN-cpu/CodeHelper-Studio.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@uiw/react-codemirror": "^4.25.10",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.40.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "thememirror": "^2.0.1",
    "undici": "^6.27.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "^41.10.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
